        <Style x:Key="AirpodText" TargetType="Label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Panel.ZIndex" Value="1"/>
            <Setter Property="Margin" Value="0,0,-35,0"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>
    
    <StackPanel Orientation="Horizontal" Margin="2,2,2,2">
        <!--<Label x:Name="leftPodChargeText" FontSize="10" Foreground="White" Panel.ZIndex="1" Margin="0,-20,-35,0" Height="25" HorizontalAlignment="Center" Content="10%"/>-->
        <Label x:Name="leftPodChargeText" Style="{StaticResource AirpodText}" Content="10%"/>
        <!--<local:OutlinedTextBlock
            x:Name="leftPodChargeText"
            Fill="White" 
            Stroke="Black" 
            HorizontalAlignment="Center"
            VerticalAlignment="Center" 
            Panel.ZIndex="2"
            StrokeThickness="3.0"
            >
            10%
        </local:OutlinedTextBlock>-->
        <Path x:Name="leftPod" Fill="#eee" Stroke="#000000" Data="{StaticResource Airpod}" Stretch="Uniform" Margin="0,0,5,-20">
        </Path>
        <Label x:Name="rightPodChargeText" Style="{StaticResource AirpodText}" Content="20%"/>
        <Path x:Name="rightPod" Fill="#eee" Stroke="#000000" Data="{StaticResource Airpod}" Stretch="Uniform" Margin="0,0,0,-20">
            <Path.LayoutTransform>
                <ScaleTransform ScaleX="-1.0" ScaleY="1.0"/>
            </Path.LayoutTransform>
        </Path>
    </StackPanel>
</UserControl>
